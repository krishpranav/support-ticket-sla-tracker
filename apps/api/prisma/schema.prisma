generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  REPORTER
  AGENT
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}
enum EventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  COMMENTED
  PAUSED
  RESUMED
  RESOLVED
  REOPENED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(REPORTER)
  createdAt DateTime @default(now())
  reportedTickets Ticket[] @relation("Reporter")
  assignedTickets Ticket[] @relation("Assignee")
  comments Comment[]
  events TicketEvent[] @relation("EventActor")
}
model Ticket {
  id String @id @default(cuid())
  reference Int @unique @default(autoincrement())
  title String
  description String
  priority Priority
  status TicketStatus @default(OPEN)
  reporterId String
  assigneeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firstResponseAt DateTime?
  resolvedAt DateTime?
  firstResponseDueAt DateTime
  firstResponseAtRiskAt DateTime
  resolutionDueAt DateTime
  resolutionAtRiskAt DateTime
  firstResponseSlaMet Boolean?
  resolutionSlaMet Boolean?
  slaPausedAt DateTime?
  slaPausedMinutes Int @default(0)
  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  assignee User? @relation("Assignee", fields: [assigneeId], references: [id])
  comments Comment[]
  events TicketEvent[]
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([firstResponseDueAt])
  @@index([resolutionDueAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}
model Comment {
  id String @id @default(cuid())
  content String
  createdAt DateTime @default(now())
  ticketId String
  authorId String
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}
model Holiday {
  id String @id @default(cuid())
  date DateTime @unique @db.Date
  name String
  createdAt DateTime @default(now())
}
model TicketEvent {
  id String @id @default(cuid())
  type EventType
  metadata Json?
  createdAt DateTime @default(now())
  ticketId String
  actorId String
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor User @relation("EventActor", fields: [actorId], references: [id])
}
